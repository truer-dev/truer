#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
status=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
  *[!0]*) ;;
  *) continue ;;
  esac

  for sha in $(git rev-list "$local_sha" --not --remotes); do
    "$root/.githooks/subject-valid.sh" "$(git log -1 --format=%s "$sha")" ||
      status=1
  done
done

[ "$status" -eq 0 ] ||
  echo "pre-push: rewrite them with 'git rebase -i --exec \"git commit --amend\"'" >&2

exit "$status"
